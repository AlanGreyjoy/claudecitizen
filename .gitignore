# Dependencies
node_modules/

# Build output
dist/
dist-editor/
.asteron-build/
release/
target/
backend/target/
public/wasm/cc_sim_core.wasm
*.tsbuildinfo

# Vite
.vite/

# Environment & secrets (keep .env.example if you add one)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local tooling
*.local
.cache/

# Generated spawn-corridor tile packs (run npm run bake:spawn-tiles)
public/cache/spawn/*.bin
public/cache/spawn/*.json
!public/cache/spawn/README.md

# Proprietary / project-local packs (never commit binaries).
# When this checkout is opened as an AsteronEngine project, drop importable
# GLBs under ./assets/ — that tree is project-scoped, not an engine library.
# Prefab documents are the exception: they are metadata (asset paths only), so
# they stay committed wherever the author files them.
/assets/**
!/assets/**/
!/assets/**/*.prefab.json
!/assets/README.md
public/assets/protected/**
!public/assets/protected/
!public/assets/protected/README.md

# Docusaurus local build / Netlify CLI state (docs site only)
docs/build/
docs/.docusaurus/
.netlify/
