# Copy to deploy/.env on the server and fill in. Never commit the filled copy.
#
#   cp deploy/.env.example deploy/.env
#
# Generate every secret below with:  openssl rand -base64 32

# --- Domains -----------------------------------------------------------------
# The API hostname you pointed at this box (A record -> server IP).
API_DOMAIN=api.example.com
API_PUBLIC_URL=https://api.example.com

# The exact origin players load the game from. The backend allows exactly ONE
# origin, so a Netlify preview URL will not work — use the site's real URL.
# No trailing slash.
CLIENT_ORIGIN=https://your-site.netlify.app

# Origins accepted on the WebTransport handshake — a separate list from
# CLIENT_ORIGIN, checked by the UDP listener rather than by CORS. It must
# contain the origin above, or players load the game, authenticate, chat with
# themselves, and never see another player: the REST API answers normally while
# every world session is rejected. Comma-separated, no trailing slash.
WEBTRANSPORT_ALLOWED_ORIGINS=https://your-site.netlify.app

# WebTransport is a separate UDP listener on this box; it is not proxied by
# Caddy, so the port stays in the URL. Same hostname, same certificate.
WEBTRANSPORT_PUBLIC_URL=https://api.example.com:4433/world

# Where sync-certs.sh drops the certificate pair that both Caddy and the
# WebTransport listener read.
CERT_DIR=/opt/asteron/certs

# --- Secrets -----------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_SESSION_SECRET=
PAYMENTS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Operator login for the Server console.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Player Discord OAuth (title/login "Login with Discord"). Leave empty to disable.
# Discord Developer Portal redirect must match DISCORD_REDIRECT_URI exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.example.com/auth/discord/callback

# --- Observability -----------------------------------------------------------
# Both are listed in docker-compose.yml's environment map, which is what
# actually forwards them into the container. Setting them here alone would do
# nothing: compose reads this file for ${VAR} interpolation, not for injection.
RUST_LOG=cc_server=info,tower_http=info
# anyhow captures a backtrace only when this is set, and that backtrace is what
# fills the `backtrace` field on every 500.
RUST_BACKTRACE=1

# Everything below is opt-in. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty and the
# backend never attempts an export — the deploy behaves exactly as it did
# before observability existed.
#
# To turn it on:
#   1. Set a real ZO_ROOT_USER_PASSWORD.
#   2. Uncomment COMPOSE_PROFILES so the two services actually start.
#   3. Base64 "email:password" and paste it into both header variables:
#        printf '%s' "$ZO_ROOT_USER_EMAIL:$ZO_ROOT_USER_PASSWORD" | base64 -w0
#   4. Redeploy. The UI is loopback-only; reach it with
#        ssh -N -L 5080:127.0.0.1:5080 <user>@<host>
#COMPOSE_PROFILES=observability
ZO_ROOT_USER_EMAIL=admin@claude-citizen.com
# 8-128 characters with at least one lowercase, one uppercase, one digit and one
# special character. OpenObserve validates this at startup and panics if it
# fails, so a weak value shows up as a container restart loop.
ZO_ROOT_USER_PASSWORD=
# The exporter appends /v1/traces and /v1/logs to this base itself.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Format is W3C: comma-separated key=value. The value carries credentials.
# Quote it — the value contains a space, and an unquoted value is truncated
# there by the .env parser, which turns into a 401 on every export.
#OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 of email:password>"
OTEL_EXPORTER_OTLP_HEADERS=
# Used by the collector, which forwards the Prometheus scrape. Same credentials.
#OPENOBSERVE_AUTH_HEADER=Basic <base64 of email:password>
OPENOBSERVE_AUTH_HEADER=
