{
  "name": "claudecitizen",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "editor": "npm run build:editor:web && node editor-desktop/brand_dev_electron.mjs && electron editor-desktop",
    "editor:dev": "npm run build:wasm && node editor-desktop/brand_dev_electron.mjs && electron editor-desktop --dev",
    "editor:desktop:package": "npm run build:editor:web && electron-builder --projectDir editor-desktop",
    "build:editor:web": "npm run build:wasm && tsc --noEmit && vite build --mode editor --outDir dist-editor",
    "build:editor:desktop": "npm run build:editor:web && electron-builder --projectDir editor-desktop --dir",
    "build:wasm": "node scripts/build_wasm.mjs",
    "build:web": "npm run build:wasm && tsc --noEmit && vite build",
    "build:project-web": "node scripts/build_project_web.mjs",
    "build:server": "cargo build --locked --release --manifest-path backend/Cargo.toml -p cc-server",
    "dev:infra": "docker compose up -d postgres redis mailpit",
    "dev:observability": "docker compose --profile observability up -d openobserve otel-collector",
    "obs": "node scripts/obs.mjs",
    "dev:server": "watchexec --restart --stop-timeout 20s --no-vcs-ignore --watch backend --watch proto --watch rust-toolchain.toml -- cargo run --locked --manifest-path backend/Cargo.toml -p cc-server",
    "start:server": "cargo run --locked --manifest-path backend/Cargo.toml -p cc-server",
    "backend:migrate": "cargo run --locked --manifest-path backend/Cargo.toml -p cc-server -- migrate",
    "demo": "tsx scripts/spike-demo.ts",
    "pack:anims": "node scripts/pack_animation_glbs.mjs",
    "transcode:textures": "node scripts/transcode_project_textures.mjs",
    "typecheck": "tsc --noEmit",
    "terrain:validate": "tsx scripts/validate_terrain_system.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mcp:asteron": "node tools/asteron-mcp/src/index.mjs",
    "docs:dev": "npm run start -w docs",
    "docs:build": "npm run build -w docs",
    "prepare": "husky || true",
    "secrets:check": "./scripts/check-secrets.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.19.3",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-geospatial": "^0.9.1",
    "lucide": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simplex-noise": "^4.0.3",
    "ssh2": "^1.17.0",
    "three": "0.182.0",
    "three-mesh-bvh": "^0.9.0",
    "vite": "^8.1.2"
  }
}
