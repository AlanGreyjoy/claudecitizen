APP_ENV=development
RUST_LOG=cc_server=debug,tower_http=info
HTTP_BIND=0.0.0.0:3000
CLIENT_ORIGIN=http://localhost:4173
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://claude:citizen@localhost:5432/claude_citizen
REDIS_URL=redis://localhost:6379
RUN_MIGRATIONS=true

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ADMIN_EMAIL=admin@claude-citizen.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=dev-admin-secret-change-me
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ClaudeCitizen <noreply@localhost>

# Payments (AsteronCredits / Stripe).
# PAYMENTS_ENCRYPTION_KEY wraps the Stripe secrets that the Server console stores in Postgres.
# It must be base64 for exactly 32 bytes. Generate a real one with:
#   openssl rand -base64 32
# The value below is a development placeholder and must be replaced before going live.
PAYMENTS_ENCRYPTION_KEY=ZGV2LW9ubHktYXN0ZXJvbi1wYXltZW50cy1rZXktMzI=
# Optional. When set, these override whatever the Server console has stored, which suits
# deployments that manage secrets outside the database. Leave empty to configure Stripe from
# the editor's Server console instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WEBTRANSPORT_BIND=0.0.0.0:4433
WEBTRANSPORT_PUBLIC_URL=https://localhost:4433/world
# Production uses a mounted PEM certificate/key. When omitted in development,
# the server creates a browser-compatible short-lived self-signed certificate.
WEBTRANSPORT_CERT_PATH=
WEBTRANSPORT_KEY_PATH=

