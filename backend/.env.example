APP_ENV=development
RUST_LOG=cc_server=debug,tower_http=info
# Required for a 500's log line to carry frames in its `backtrace` field.
# anyhow only captures a backtrace when this is set.
RUST_BACKTRACE=1

# Logs and traces go nowhere until these are set — the server exports only when
# an endpoint is configured, so without them OpenObserve stays empty while
# stdout looks perfectly healthy. Confirm it took effect: startup logs
# "OTLP export enabled" when the endpoint is set, and nothing when it is not.
#
# `localhost` because `npm run dev:server` runs on the host, not in compose.
# The credentials are the development defaults from docker-compose.yml:
#   printf '%s' 'admin@claude-citizen.com:Dev-Observe-1!' | base64 -w0
# Client telemetry ingest derives its own URL from this one, so there is no
# third variable to keep in sync.
#
# The quotes on the headers line are REQUIRED, not style. dotenvy ends an
# unquoted value at the first space and then errors on the rest of the line, so
# `Authorization=Basic <token>` silently loses its token — and every export gets
# a 401 that only OpenObserve's access log records.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic YWRtaW5AY2xhdWRlLWNpdGl6ZW4uY29tOkRldi1PYnNlcnZlLTEh"
HTTP_BIND=0.0.0.0:3000
CLIENT_ORIGIN=http://localhost:4173
# WebTransport handshake origin allowlist (comma-separated). Defaults to
# CLIENT_ORIGIN. `cceditor://app` is the packaged desktop editor, 127.0.0.1:5173
# is `npm run editor:dev`, and `null` accepts a missing Origin header.
WEBTRANSPORT_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:5173,cceditor://app,null
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://claude:citizen@localhost:5432/claude_citizen
REDIS_URL=redis://localhost:6379
RUN_MIGRATIONS=true

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ADMIN_EMAIL=admin@claude-citizen.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=dev-admin-secret-change-me
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ClaudeCitizen <noreply@localhost>

# Payments (AsteronCredits / Stripe).
# PAYMENTS_ENCRYPTION_KEY wraps the Stripe secrets that the Server console stores in Postgres.
# It must be base64 for exactly 32 bytes. Generate a real one with:
#   openssl rand -base64 32
# The value below is a development placeholder and must be replaced before going live.
PAYMENTS_ENCRYPTION_KEY=ZGV2LW9ubHktYXN0ZXJvbi1wYXltZW50cy1rZXktMzI=
# Optional. When set, these override whatever the Server console has stored, which suits
# deployments that manage secrets outside the database. Leave empty to configure Stripe from
# the editor's Server console instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WEBTRANSPORT_BIND=0.0.0.0:4433
# An IP literal, not `localhost`: Chromium's resolver maps localhost to ::1
# before 127.0.0.1, and this endpoint binds IPv4 only, so a `localhost` dial
# times out as `WebTransportError: Opening handshake failed.`
WEBTRANSPORT_PUBLIC_URL=https://127.0.0.1:4433/world
# Production uses a mounted PEM certificate/key. When omitted in development,
# the server creates a browser-compatible short-lived self-signed certificate.
WEBTRANSPORT_CERT_PATH=
WEBTRANSPORT_KEY_PATH=

